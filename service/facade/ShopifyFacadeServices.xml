<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- DAR-BE-275 -->
    <service verb="begin" noun="ShopifyInstall" allow-remote="true" authenticate="true">
        <description>Start installing Darpan's Shopify app on a store for the active tenant: mint a
            single-use state and return the Shopify authorize URL the browser should be sent to. Does not
            contact Shopify. The install creates its own connection; existing connections are untouched.</description>
        <in-parameters>
            <parameter name="shopDomain" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="authorizeUrl"/>
        </out-parameters>
        <actions>
            <set field="tenantId" from="darpan.facade.common.TenantAccessSupport.currentActiveTenantUserGroupId(ec)"/>
            <if condition="!tenantId"><message error="true">Active tenant is required to connect Shopify.</message></if>
            <if condition="!ec.message.hasError()">
                <set field="ignoreWriteAccess" from="darpan.facade.common.TenantAccessSupport.requireActiveTenantWriteAccess(ec, 'Your active tenant only has view access for Shopify connections.')"/>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="authorizeUrl" from="shopify.facade.settings.ShopifyInstallSupport.beginInstall(ec, tenantId, darpan.facade.common.TenantAccessSupport.currentUserId(ec), shopDomain)"/>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="list" noun="ShopifyAuthConfigs" authz-action="view" allow-remote="true" authenticate="true">
        <description>List Shopify auth configs for the active tenant with secret redaction indicators.</description>
        <in-parameters>
            <parameter name="query"/>
            <parameter name="pageIndex" type="Integer" default-value="0"/>
            <parameter name="pageSize" type="Integer" default-value="20"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="pagination" type="Map">
                <parameter name="pageIndex" type="Integer"/>
                <parameter name="pageSize" type="Integer"/>
                <parameter name="totalCount" type="Integer"/>
                <parameter name="pageCount" type="Integer"/>
            </parameter>
            <parameter name="shopifyAuthConfigs" type="List">
                <parameter name="shopifyAuthConfigId"/>
                <parameter name="description"/>
                <parameter name="companyUserGroupId"/>
                <parameter name="companyLabel"/>
                <parameter name="createdByUserId"/>
                <parameter name="shopApiUrl"/>
                <parameter name="apiVersion"/>
                <parameter name="timeZone"/>
                <parameter name="isActive"/>
                <parameter name="canReadOrders" type="Boolean"/>
                <parameter name="hasAccessToken" type="Boolean"/>
                <parameter name="isShared" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <script>context.putAll(shopify.facade.settings.ShopifyAuthConfigSupport.listAuthConfigs(ec, query, pageIndex, pageSize))</script>
        </actions>
    </service>

    <service verb="get" noun="ShopifyAuthConfig" authz-action="view" allow-remote="true" authenticate="true">
        <description>Get one Shopify auth config for the active tenant with the access token redacted.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="shopifyAuthConfig" type="Map">
                <parameter name="shopifyAuthConfigId"/>
                <parameter name="description"/>
                <parameter name="companyUserGroupId"/>
                <parameter name="companyLabel"/>
                <parameter name="createdByUserId"/>
                <parameter name="shopApiUrl"/>
                <parameter name="apiVersion"/>
                <parameter name="timeZone"/>
                <parameter name="isActive"/>
                <parameter name="canReadOrders" type="Boolean"/>
                <parameter name="hasAccessToken" type="Boolean"/>
                <parameter name="isShared" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <script>context.putAll(shopify.facade.settings.ShopifyAuthConfigSupport.getAuthConfig(ec, shopifyAuthConfigId))</script>
        </actions>
    </service>

    <service verb="save" noun="ShopifyAuthConfig" allow-remote="true" authenticate="true">
        <description>Create or update a tenant-owned Shopify auth config, preserving the stored token when no replacement is provided.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId"><description>DAR-BE-135: names a config this tenant owns or was granted,
                to update it. Leave it out to create one; the server mints the id.</description></parameter>
            <parameter name="description"/>
            <parameter name="shopApiUrl" required="true"/>
            <parameter name="apiVersion" required="true"/>
            <parameter name="timeZone"/>
            <parameter name="accessToken"/>
            <parameter name="isActive"/>
            <parameter name="canReadOrders"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="savedShopifyAuthConfig" type="Map">
                <parameter name="shopifyAuthConfigId"/>
                <parameter name="description"/>
                <parameter name="companyUserGroupId"/>
                <parameter name="companyLabel"/>
                <parameter name="createdByUserId"/>
                <parameter name="shopApiUrl"/>
                <parameter name="apiVersion"/>
                <parameter name="timeZone"/>
                <parameter name="isActive"/>
                <parameter name="canReadOrders" type="Boolean"/>
                <parameter name="hasAccessToken" type="Boolean"/>
                <parameter name="isShared" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <script>context.putAll(shopify.facade.settings.ShopifyAuthConfigSupport.saveAuthConfig(ec, context))</script>
        </actions>
    </service>

    <service verb="delete" noun="ShopifyAuthConfig" allow-remote="true" authenticate="true">
        <description>Delete one tenant-owned Shopify auth config.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="deleted" type="Boolean"/>
            <parameter name="deletedShopifyAuthConfigId"/>
        </out-parameters>
        <actions>
            <script>context.putAll(shopify.facade.settings.ShopifyAuthConfigSupport.deleteAuthConfig(ec, shopifyAuthConfigId))</script>
        </actions>
    </service>

    <!-- Setup-flow catalog services are internal-only until a UI consumer is wired; flip
         allow-remote back to true together with the consuming setup flow. -->
    <service verb="list" noun="ShopifySourceDefinitions" authz-action="view" allow-remote="false" authenticate="true">
        <description>List Shopify source definitions and selectable field catalogs for setup flows.</description>
        <in-parameters>
            <parameter name="apiVersion"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="sourceDefinitions" type="List"/>
        </out-parameters>
        <actions>
            <set field="sourceDefinitions" from="shopify.graphql.ShopifySourceCatalog.listSources(apiVersion)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="get" noun="ShopifySourceDefinition" authz-action="view" allow-remote="false" authenticate="true">
        <description>Get one Shopify source definition and its selectable fields for an API version.</description>
        <in-parameters>
            <parameter name="sourceDefinitionId" required="true"/>
            <parameter name="apiVersion"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="sourceDefinition" type="Map"/>
        </out-parameters>
        <actions>
            <set field="sourceId" from="shopify.graphql.ShopifySourceCatalog.normalizeSourceDefinitionId(sourceDefinitionId)"/>
            <if condition="!sourceId">
                <message error="true">Shopify source definition ID is required.</message>
            </if>
            <if condition="!ec.message.hasError()">
                <set field="sourceDefinition" from="shopify.graphql.ShopifySourceCatalog.getSource(sourceId, apiVersion)"/>
                <if condition="sourceDefinition == null">
                    <set field="apiVersionValue" from="shopify.graphql.ShopifySourceCatalog.normalizeApiVersion(apiVersion)"/>
                    <message error="true">${apiVersionValue ? 'Shopify source ' + sourceId + ' is not available for API version ' + apiVersionValue + '.' : 'Shopify source ' + sourceId + ' was not found.'}</message>
                </if>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="build" noun="ShopifyGraphqlQuery" allow-remote="false" authenticate="true">
        <description>Build a Shopify Admin GraphQL query from structured source, field, filter, and pagination requirements.</description>
        <in-parameters>
            <parameter name="sourceDefinitionId" required="true"/>
            <parameter name="apiVersion"/>
            <parameter name="selectedFieldPaths" type="List"/>
            <parameter name="filters" type="Map"/>
            <parameter name="pageSize" type="Integer" default-value="100"/>
            <parameter name="afterCursor"/>
            <parameter name="reverse"/>
            <parameter name="connectionPageSizes" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="builtQuery" type="Map"/>
        </out-parameters>
        <actions>
            <set field="builtQuery" from="shopify.facade.graphql.ShopifyGraphqlFacadeSupport.buildGraphqlQuery(ec, context)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="execute" noun="ShopifyGraphql" allow-remote="false" authenticate="true">
        <description>Execute a generated Shopify Admin GraphQL query through a tenant-owned auth config.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
            <parameter name="queryDocument" required="true" allow-html="any"/>
            <parameter name="variables" type="Map"/>
            <parameter name="connectTimeoutMillis" type="Integer" default-value="30000"/>
            <parameter name="readTimeoutMillis" type="Integer" default-value="60000"/>
            <parameter name="maxAttempts" type="Integer" default-value="2"/>
            <parameter name="retryDelayMillis" type="Integer">
                <description>Delay between retryable attempts. When unset, THROTTLED/429 retries derive a wait from Shopify's throttleStatus cost metadata and other retryable failures retry immediately.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="messages" type="List"><parameter name="message"/></parameter>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="graphqlResult" type="Map"/>
        </out-parameters>
        <actions>
            <set field="graphqlResult" from="shopify.facade.graphql.ShopifyGraphqlFacadeSupport.executeGraphql(ec, context)"/>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="messages" from="darpan.facade.common.FacadeSupport.getMessages(ec)"/>
            <set field="errors" from="darpan.facade.common.FacadeSupport.getErrors(ec)"/>
        </actions>
    </service>

    <service verb="run" noun="ShopifyGraphqlAgentQuery" allow-remote="true" authenticate="true">
        <description>DAR-CLI-003. Runs one fresh, read-only GraphQL query a tenant user's agent wrote, through a Shopify
            connection the active tenant stores. One query only (no mutation, subscription or introspection); the answer
            is returned as Shopify gave it, up to 5 MB, or refused with advice when larger; the connection's access token
            is never returned. Needs run access. Every call is logged for the tenant.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
            <parameter name="document" required="true" allow-html="any"/>
            <parameter name="variables" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="data" type="Map"/>
            <parameter name="rowCount" type="Integer"><description>The edge count when the answer is one connection, else blank.</description></parameter>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="durationMs" type="Long"/>
            <parameter name="code"/>
            <parameter name="retryAfterSeconds" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="queryResult" from="shopify.facade.graphql.ShopifyAgentQuerySupport.runAgentQuery(ec, context)"/>
            <set field="data" from="queryResult?.data"/>
            <set field="rowCount" from="queryResult?.rowCount"/>
            <set field="truncated" from="queryResult?.truncated"/>
            <set field="durationMs" from="queryResult?.durationMs"/>
            <set field="code" from="queryResult?.code"/>
            <set field="retryAfterSeconds" from="queryResult?.retryAfterSeconds"/>
            <if condition="queryResult?.error">
                <message error="true">${queryResult.error}</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="errors" from="ec.message.errors"/>
        </actions>
    </service>

    <service verb="get" noun="ShopifyGraphqlSchema" authz-action="view" allow-remote="true" authenticate="true">
        <description>DAR-CLI-003. The Shopify Admin GraphQL schema a tenant's agent can ask about, trimmed to the types
            reachable from the Query root (names, kinds, fields, arguments, enum values and descriptions; mutations and
            subscriptions left out). Read from Shopify once and kept 24 hours per connection. Needs view access.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="errors" type="List"><parameter name="error"/></parameter>
            <parameter name="schema" type="Map"/>
            <parameter name="code"/>
            <parameter name="retryAfterSeconds" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="schemaResult" from="shopify.facade.graphql.ShopifyAgentQuerySupport.getSchema(ec, context)"/>
            <set field="schema" from="schemaResult?.schema"/>
            <set field="code" from="schemaResult?.code"/>
            <set field="retryAfterSeconds" from="schemaResult?.retryAfterSeconds"/>
            <if condition="schemaResult?.error">
                <message error="true">${schemaResult.error}</message>
            </if>
            <set field="ok" from="!ec.message.hasError()"/>
            <set field="errors" from="ec.message.errors"/>
        </actions>
    </service>

    <service verb="probe" noun="ShopifyAuthConnection" allow-remote="false" authenticate="true">
        <description>Connection diagnostics for a saved Shopify auth config. Registered on the
            SourceSystemConnector SHOPIFY row as healthCheckServiceName and invoked only through
            facade.SettingsFacadeServices.test#SourceConnection, which owns the permission gate.
            Reads only, no retries: one order, then one bulk read that matches no order, because
            runs read through bulk operations and Shopify gates those on the token (DAR-BE-243).
            Never writes to ec.message: a rejected credential
            is a check row, not a service error.</description>
        <in-parameters>
            <parameter name="shopifyAuthConfigId" required="true"/>
            <parameter name="stage">
                <description>Run just this stage and report the next one, so the caller can show
                    progress as each completes. Blank runs every stage in a single call.</description>
            </parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="checks" type="List">
                <parameter name="check" type="Map">
                    <parameter name="key"/>
                    <parameter name="label"/>
                    <parameter name="status"/>
                    <parameter name="detail"/>
                    <parameter name="durationMillis" type="Long"/>
                </parameter>
            </parameter>
            <parameter name="nextStage">
                <description>Stage to run next, or blank when the probe is finished — either it
                    completed or a failure made the remaining stages meaningless.</description>
            </parameter>
            <parameter name="endpoints" type="List">
                <description>Per-endpoint enablement for this config (SourceEndpointAccessSupport
                    .listEndpointsForConfig), not a single canReadOrders flag — a token issued before
                    an endpoint existed can be enabled for it without carrying the scope it needs.</description>
                <parameter name="systemEnumId"/>
                <parameter name="endpointLabel"/>
                <parameter name="isEnabled" type="Boolean"/>
            </parameter>
        </out-parameters>
        <actions>
            <script>context.putAll(shopify.facade.settings.ShopifyConnectionProbe.probeConnection(ec, shopifyAuthConfigId, [:], stage))</script>
        </actions>
    </service>

</services>
